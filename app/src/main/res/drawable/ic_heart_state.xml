<?xml version="1.0" encoding="utf-8"?>
<!-- Heart toggle: view.isSelected = true shows the filled heart, false the outline -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true" android:drawable="@drawable/ic_heart_filled" />
    <item android:drawable="@drawable/ic_heart_outline" />
</selector>