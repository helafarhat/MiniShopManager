<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/screenRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:orientation="vertical">

    <!-- Top bar -->
    <LinearLayout
        style="@style/MiniShop.TopBar"
        android:paddingStart="@dimen/space_sm"
        android:paddingEnd="@dimen/space_sm">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTopBack"
            style="@style/Widget.MiniShop.Button.Icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="Retour"
            app:icon="@drawable/ic_arrow_back" />

        <TextView
            style="@style/MiniShop.TopBarTitle"
            android:text="Our Collection" />

        <include
            layout="@layout/view_top_actions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/screen_padding"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="@dimen/space_sm"
        android:text="Find something you love ♡"
        android:textAppearance="@style/TextAppearance.MiniShop.Body.Secondary" />

    <!-- Product grid (grid cells ignore margins, so each item wraps its card in padding) -->
    <GridView
        android:id="@+id/listViewProduits"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:horizontalSpacing="0dp"
        android:numColumns="2"
        android:paddingStart="16dp"
        android:paddingTop="@dimen/space_xs"
        android:paddingEnd="16dp"
        android:paddingBottom="@dimen/space_md"
        android:scrollbars="none"
        android:stretchMode="columnWidth"
        android:verticalSpacing="0dp" />

</LinearLayout>
