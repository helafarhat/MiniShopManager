<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/screenRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:orientation="vertical">

    <LinearLayout
        style="@style/MiniShop.TopBar"
        android:paddingStart="@dimen/space_sm"
        android:paddingEnd="@dimen/space_sm">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTopBack"
            style="@style/Widget.MiniShop.Button.Icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="Retour"
            app:icon="@drawable/ic_arrow_back" />

        <TextView
            style="@style/MiniShop.TopBarTitle"
            android:text="My Shopping Bag" />
        <include
        layout="@layout/view_top_actions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/screen_padding"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="@dimen/space_sm"
        android:text="Your selected favorites ♡"
        android:textAppearance="@style/TextAppearance.MiniShop.Body.Secondary" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/listViewCart"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@android:color/transparent"
            android:dividerHeight="4dp"
            android:paddingStart="16dp"
            android:paddingTop="@dimen/space_xs"
            android:paddingEnd="16dp"
            android:paddingBottom="@dimen/space_md"
            android:scrollbars="none" />

        <!-- Empty state (shown/hidden by CartActivity) -->
        <LinearLayout
            android:id="@+id/tvEmptyCart"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/space_xl"
            android:visibility="gone">

            <ImageView
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:background="@drawable/bg_icon_circle"
                android:importantForAccessibility="no"
                android:padding="24dp"
                android:src="@drawable/ic_empty_bag" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:gravity="center"
                android:text="Votre panier est vide ♡"
                android:textAppearance="@style/TextAppearance.MiniShop.Title" />
        </LinearLayout>
    </FrameLayout>

    <!-- Summary + checkout -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_bar"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <TextView
            android:id="@+id/tvTotal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="Total : 0.00 DT"
            android:textAppearance="@style/TextAppearance.MiniShop.Headline"
            android:textColor="@color/accent_text" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCheckout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:text="Proceed to payment"
            app:icon="@drawable/ic_arrow_forward"
            app:iconGravity="textEnd" />
    </LinearLayout>

</LinearLayout>
