<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_card"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_lg"
        android:paddingTop="@dimen/space_sm"
        android:paddingEnd="@dimen/space_lg"
        android:paddingBottom="@dimen/space_lg">

        <!-- Close (48dp touch target) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCloseSpinPopup"
            style="@style/Widget.MiniShop.Button.Icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginEnd="-12dp"
            android:contentDescription="Close pop-up"
            app:icon="@drawable/ic_close" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="A little surprise for you ♡"
            android:textAppearance="@style/TextAppearance.MiniShop.Headline" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:layout_marginBottom="@dimen/space_md"
            android:gravity="center"
            android:text="Spin the wheel and discover your exclusive discount!"
            android:textAppearance="@style/TextAppearance.MiniShop.Body.Secondary" />

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_pointer" />

        <com.example.minishopmanager.PrizeWheelView
            android:id="@+id/popupPrizeWheel"
            android:layout_width="260dp"
            android:layout_height="260dp"
            android:layout_gravity="center" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPopupSpinNow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:text="Spin now" />

        <TextView
            android:id="@+id/tvPopupSpinResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.MiniShop.Body.Strong"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCopyCoupon"
            style="@style/Widget.MiniShop.Button.Tonal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:text="Copy coupon code"
            android:visibility="gone"
            app:icon="@drawable/ic_copy" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:gravity="center"
            android:text="Your coupon is valid for 7 days ♡"
            android:textAppearance="@style/TextAppearance.MiniShop.Caption" />
    </LinearLayout>
</ScrollView>
