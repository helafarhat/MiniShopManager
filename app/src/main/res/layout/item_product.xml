<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="10dp"
    android:layout_margin="5dp"
    android:background="@drawable/bg_product_card">

    <ImageView
        android:id="@+id/imgProduct"
        android:layout_width="match_parent"
        android:layout_height="125dp"
        android:scaleType="centerCrop"
        android:contentDescription="Image du produit"/>

    <TextView
        android:id="@+id/tvProductName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@color/mocha"
        android:textSize="15sp"
        android:textStyle="bold"
        android:maxLines="2"/>

    <TextView
        android:id="@+id/tvProductPrice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:textColor="@color/rosewood"
        android:textSize="15sp"
        android:textStyle="bold"/>

    <Button
        android:id="@+id/btnAjouterPanier"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="10dp"
        android:text="Ajouter au panier"
        android:textSize="11sp"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:backgroundTint="@color/rosewood"/>

</LinearLayout>
