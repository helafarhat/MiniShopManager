<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <!-- Logo -->
        <include
            layout="@layout/logo_wordmark" />

        <!-- Welcome -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="Bonjour !"
            android:textColor="@color/mocha"
            android:textSize="30sp"
            android:textStyle="bold"
            android:fontFamily="serif"/>

        <TextView
            android:id="@+id/tvWelcomeName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bienvenue dans votre boutique !"
            android:textColor="@color/muted_text"
            android:textSize="16sp"
            android:layout_marginTop="8dp"/>

        <!-- Promotional banner -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_home_banner"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:padding="22dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="YOUR LITTLE\nSHOPPING CORNER"
                android:textColor="@color/mocha"
                android:textSize="23sp"
                android:textStyle="bold"
                android:fontFamily="serif"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Découvrez nos essentiels"
                android:textColor="@color/mocha"
                android:textSize="14sp"/>

        </LinearLayout>

        <!-- Featured section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Découvrez notre boutique"
            android:textColor="@color/mocha"
            android:textSize="21sp"
            android:textStyle="bold"
            android:fontFamily="serif"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Technologie, accessoires et beauté : trouvez vos coups de cœur."
            android:textColor="@color/muted_text"
            android:textSize="14sp"/>

        <!-- Catalogue button -->
        <Button
            android:id="@+id/btnVoirCatalogue"
            style="@style/MiniShopButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:text="Découvrir le catalogue  →"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:gravity="center"
            android:text="Made with care ♡ MiniShopManager"
            android:textColor="@color/muted_text"
            android:textSize="12sp"/>

    </LinearLayout>

</ScrollView>
