<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- Logo -->
        <include
            layout="@layout/logo_wordmark" />

        <!-- Product image -->
        <ImageView
            android:id="@+id/imgDetailProduct"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:layout_marginTop="25dp"
            android:scaleType="fitCenter"
            android:contentDescription="Product image" />

        <!-- Product name -->
        <TextView
            android:id="@+id/tvDetailName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:textColor="@color/mocha"
            android:textSize="27sp"
            android:textStyle="bold"
            android:fontFamily="serif" />

        <!-- Price -->
        <TextView
            android:id="@+id/tvDetailPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/rosewood"
            android:textSize="21sp"
            android:textStyle="bold" />

        <!-- Description title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="About this product"
            android:textColor="@color/mocha"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="serif" />

        <!-- Description -->
        <TextView
            android:id="@+id/tvDetailDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/muted_text"
            android:textSize="15sp"
            android:lineSpacingExtra="5dp" />

        <!-- Add to cart -->
        <Button
            android:id="@+id/btnAddDetailCart"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="30dp"
            android:text="Ajouter au panier  ♡"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:backgroundTint="@color/rosewood" />

        <!-- Back button -->
        <Button
            android:id="@+id/btnBackCatalogue"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:text="Retour au catalogue"
            android:textAllCaps="false"
            android:textColor="@color/mocha"
            android:backgroundTint="@color/blush" />

    </LinearLayout>

</ScrollView>