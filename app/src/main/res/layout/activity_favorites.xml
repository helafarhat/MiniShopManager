<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/screenRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:orientation="vertical">

    <LinearLayout
        style="@style/MiniShop.TopBar"
        android:paddingStart="@dimen/space_sm"
        android:paddingEnd="@dimen/space_sm">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTopBack"
            style="@style/Widget.MiniShop.Button.Icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="Retour"
            app:icon="@drawable/ic_arrow_back" />

        <TextView
            style="@style/MiniShop.TopBarTitle"
            android:text="My Favorites" />

        <!-- On this screen only the cart shortcut is shown (see setupScreen) -->
        <include
            layout="@layout/view_top_actions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/screen_padding"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="@dimen/space_sm"
        android:text="The pieces you love ♡"
        android:textAppearance="@style/TextAppearance.MiniShop.Body.Secondary" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Same grid settings as the catalogue so both screens feel identical -->
        <GridView
            android:id="@+id/gridFavorites"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:horizontalSpacing="0dp"
            android:numColumns="2"
            android:paddingStart="16dp"
            android:paddingTop="@dimen/space_xs"
            android:paddingEnd="16dp"
            android:paddingBottom="@dimen/space_md"
            android:scrollbars="none"
            android:stretchMode="columnWidth"
            android:verticalSpacing="0dp" />

        <!-- Empty state (shown/hidden by FavoritesActivity) -->
        <LinearLayout
            android:id="@+id/emptyFavorites"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/space_xl"
            android:visibility="gone">

            <ImageView
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:background="@drawable/bg_icon_circle"
                android:importantForAccessibility="no"
                android:padding="24dp"
                android:src="@drawable/ic_empty_heart" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:gravity="center"
                android:text="No favorites yet ♡"
                android:textAppearance="@style/TextAppearance.MiniShop.Title" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:gravity="center"
                android:text="Tap the heart on any product to keep it here."
                android:textAppearance="@style/TextAppearance.MiniShop.Body.Secondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBrowseCollection"
                style="@style/Widget.MiniShop.Button.Tonal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:text="Browse the collection"
                app:icon="@drawable/ic_arrow_forward"
                app:iconGravity="textEnd" />
        </LinearLayout>
    </FrameLayout>

</LinearLayout>