<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ===== Brand palette (original values kept; used for fills, borders, icons) ===== -->
    <color name="cream">#FFF9F5</color>
    <color name="soft_rose">#F5E6E8</color>
    <color name="dusty_pink">#E8C9CC</color>
    <color name="rosewood">#B98282</color>
    <color name="mocha">#76565B</color>
    <color name="white">#FFFFFF</color>
    <color name="light_beige">#E9DED5</color>
    <color name="blush">#F4E4E5</color>

    <!-- ===== Accessible text tones (WCAG AA, measured) =====
         rosewood_deep: 5.9:1 on white, 5.7:1 on cream, 4.9:1 on soft_rose
         muted_text   : 5.5:1 on white, 5.3:1 on cream, 4.6:1 on soft_rose -->
    <color name="rosewood_deep">#8E5459</color>
    <color name="rosewood_pressed">#7A4549</color>
    <color name="muted_text">#7A6366</color>

    <!-- ===== Semantic tokens: use these in layouts ===== -->
    <color name="screen_background">@color/cream</color>
    <color name="card_background">@color/white</color>
    <color name="primary">@color/rosewood_deep</color>
    <color name="primary_dark">@color/mocha</color>
    <color name="on_primary">@color/white</color>
    <color name="main_text">@color/mocha</color>
    <color name="secondary_text">@color/muted_text</color>
    <color name="accent_text">@color/rosewood_deep</color>
    <color name="tonal_container">@color/soft_rose</color>
    <color name="on_tonal_container">@color/mocha</color>
    <color name="divider">@color/blush</color>
    <color name="outline">@color/dusty_pink</color>
    <color name="error">#B3261E</color>
    <color name="shadow_rose">#6B3F44</color>
    <color name="ripple_rose">#1F8E5459</color>
    <color name="overlay_white">#F2FFFFFF</color>

    <!-- Color state lists live in res/color/ -->
</resources>
