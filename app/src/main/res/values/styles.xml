<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base styles required by the MiniShop style hierarchy -->
    <style name="MiniShop" parent="" />

    <style name="TextAppearance.MiniShop"
        parent="TextAppearance.Material3.BodyMedium" />
    <!-- =====================================================================
         TYPE SCALE (6 steps)
         Display 28 · Headline 22 · Title 18 · Body 15 · Caption 13 · Label 11
         Playfair Display for headings, system sans for everything else.
         ===================================================================== -->

    <style name="TextAppearance.MiniShop.Display">
        <item name="android:fontFamily">@font/playfair</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textColor">@color/main_text</item>
    </style>

    <style name="TextAppearance.MiniShop.Headline">
        <item name="android:fontFamily">@font/playfair</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/main_text</item>
    </style>

    <style name="TextAppearance.MiniShop.Title">
        <item name="android:fontFamily">@font/playfair</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/main_text</item>
    </style>

    <style name="TextAppearance.MiniShop.Body">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/main_text</item>
    </style>

    <style name="TextAppearance.MiniShop.Body.Secondary">
        <item name="android:textColor">@color/secondary_text</item>
    </style>

    <style name="TextAppearance.MiniShop.Body.Strong">
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.MiniShop.Price">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/accent_text</item>
    </style>

    <style name="TextAppearance.MiniShop.Caption">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/secondary_text</item>
    </style>

    <style name="TextAppearance.MiniShop.Label">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/secondary_text</item>
    </style>

    <!-- Original styles kept (now point at the new tokens) -->
    <style name="MiniShopTitle" parent="TextAppearance.MiniShop.Display" />
    <style name="MiniShopBody" parent="TextAppearance.MiniShop.Body" />

    <!-- =====================================================================
         SHAPES  (cards 20dp · buttons/inputs 16dp · chips fully rounded)
         ===================================================================== -->

    <style name="ShapeAppearance.MiniShop.Card" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>

    <style name="ShapeAppearance.MiniShop.Control" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>


    <style name="ShapeAppearanceOverlay.MiniShop.ImageTop" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">20dp</item>
        <item name="cornerSizeTopRight">20dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="ShapeAppearanceOverlay.MiniShop.Image" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <!-- =====================================================================
         BUTTONS  (primary · tonal · text · icon) – all >= 48dp touch targets
         ===================================================================== -->

    <!-- Primary (filled). Applied to every MaterialButton through the theme. -->
    <style name="Widget.MiniShop.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/button_primary_bg</item>
        <item name="android:textColor">@color/button_primary_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.MiniShop.Control</item>
        <item name="rippleColor">#33FFFFFF</item>
        <item name="iconTint">@color/button_primary_text</item>
        <item name="iconPadding">8dp</item>
    </style>

    <!-- Tonal (secondary action) -->
    <style name="Widget.MiniShop.Button.Tonal" parent="Widget.MiniShop.Button">
        <item name="backgroundTint">@color/tonal_container</item>
        <item name="android:textColor">@color/on_tonal_container</item>
        <item name="iconTint">@color/on_tonal_container</item>
        <item name="rippleColor">@color/ripple_rose</item>
    </style>

    <!-- Text (tertiary action) -->
    <style name="Widget.MiniShop.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/accent_text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="rippleColor">@color/ripple_rose</item>
        <item name="iconTint">@color/accent_text</item>
    </style>

    <!-- Icon-only button, 48dp, no background (top bar actions) -->
    <style name="Widget.MiniShop.Button.Icon" parent="Widget.Material3.Button.IconButton">
        <item name="android:minWidth">@dimen/touch_target</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="iconPadding">0dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconSize">24dp</item>
        <item name="iconTint">@color/main_text</item>
        <item name="rippleColor">@color/ripple_rose</item>
        <item name="shapeAppearance">@style/ShapeAppearance.MiniShop.Control</item>
    </style>

    <!-- Icon-only tonal button (quantity stepper) -->
    <style name="Widget.MiniShop.Button.IconTonal" parent="Widget.MiniShop.Button.Icon">
        <item name="backgroundTint">@color/tonal_container</item>
        <item name="iconTint">@color/on_tonal_container</item>
    </style>

    <!-- Icon-only filled button -->
    <style name="Widget.MiniShop.Button.IconFilled" parent="Widget.MiniShop.Button.Icon">
        <item name="backgroundTint">@color/button_primary_bg</item>
        <item name="iconTint">@color/white</item>
    </style>

    <!-- =====================================================================
         CARD, INPUT, CHECKBOX, RADIO
         ===================================================================== -->

    <style name="Base.Widget.MiniShop.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/card_background</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="cardCornerRadius">@dimen/card_radius</item>
        <item name="strokeWidth">0dp</item>
        <item name="rippleColor">@color/ripple_rose</item>
        <item name="shapeAppearance">@style/ShapeAppearance.MiniShop.Card</item>
    </style>
    <style name="Widget.MiniShop.Card" parent="Base.Widget.MiniShop.Card" />

    <!-- Flat card (no shadow) for summary blocks -->
    <style name="Widget.MiniShop.Card.Flat">
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/divider</item>
    </style>

    <!-- Soft-rose card for banners / highlights -->
    <style name="Widget.MiniShop.Card.Tonal">
        <item name="cardBackgroundColor">@color/tonal_container</item>
        <item name="cardElevation">0dp</item>
    </style>

    <style name="Widget.MiniShop.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/rosewood_deep</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="hintTextColor">@color/accent_text</item>
        <item name="android:textColorHint">@color/muted_text</item>
        <item name="errorTextColor">@color/error</item>
        <item name="boxStrokeErrorColor">@color/error</item>
        <item name="shapeAppearance">@style/ShapeAppearance.MiniShop.Control</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.MiniShop.Control</item>
    </style>

    <style name="Widget.MiniShop.CheckBox" parent="Widget.Material3.CompoundButton.CheckBox">
        <item name="android:textColor">@color/main_text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="buttonTint">@color/rosewood_deep</item>
    </style>

    <style name="Widget.MiniShop.RadioButton" parent="Widget.Material3.CompoundButton.RadioButton">
        <item name="android:textColor">@color/main_text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="buttonTint">@color/rosewood_deep</item>
    </style>

    <!-- =====================================================================
         SCREEN STRUCTURE
         ===================================================================== -->

    <style name="MiniShop.TopBar">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/top_bar_height</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="MiniShop.TopBarTitle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textAppearance">@style/TextAppearance.MiniShop.Headline</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:layout_marginStart">4dp</item>
    </style>

    <style name="MiniShop.SectionTitle">
        <item name="android:textAppearance">@style/TextAppearance.MiniShop.Headline</item>
    </style>

    <!-- Selectable pill (home categories) -->
    <style name="MiniShop.Chip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">@dimen/touch_target</item>
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:textAppearance">@style/TextAppearance.MiniShop.Body.Strong</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- Bottom navigation item -->
    <style name="MiniShop.NavItem">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">@dimen/bottom_nav_height</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_nav_item</item>
        <item name="android:drawableTint">@color/nav_item_color</item>
        <item name="android:drawablePadding">4dp</item>
        <item name="android:textColor">@color/nav_item_color</item>
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- Original button style name kept: every screen using it gets the new primary look -->
    <style name="MiniShopButton" parent="Widget.MiniShop.Button" />

</resources>
