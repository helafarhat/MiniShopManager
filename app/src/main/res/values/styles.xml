<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="MiniShopTitle">
        <item name="android:fontFamily">serif</item>
        <item name="android:textColor">@color/mocha</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="MiniShopBody">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/main_text</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="MiniShopButton">
        <item name="android:backgroundTint">@color/rosewood</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

</resources>
